{
  "name": "mock-api-portal",
  "version": "1.9.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install --omit=dev && npm --prefix frontend install --include=dev",
    "dev": "node -e \"const {spawn}=require('child_process');const r=(c,a)=>spawn(c,a,{stdio:'inherit',shell:true});r('npm',['--prefix','server','run','dev']);r('npm',['--prefix','frontend','run','dev']);\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "release": "sh deploy/make-release.sh",
    "package": "sh deploy/build-package.sh"
  },
  "engines": {
    "node": ">=20.19"
  }
}
